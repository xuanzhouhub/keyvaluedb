	$(MAKE) $(MAKESILENT) -f CMakeFiles\test_sstable.dir\build.make /nologo -$(MAKEFLAGS) CMakeFiles\test_sstable.dir\tests\test_sstable.cpp.i
.PHONY : tests\test_sstable.cpp.i

